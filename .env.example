# Public Firebase Web App configuration (safe to include in browser builds).
# Never place service-account JSON, private keys, or admin credentials in VITE_* variables.
VITE_FIREBASE_API_KEY=replace-with-public-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id

# Local development only
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
