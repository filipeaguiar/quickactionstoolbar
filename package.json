  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "~5.4.5",
    "vite": "^5.1.4",
    "vitest": "^1.3.1",
    "vue-tsc": "^2.2.12"
  }
}
